@model StokDepo.Models.Product

@if (User.IsInRole("Admin"))
{
    <a class="btn btn-outline-primary"
       asp-controller="StockMovements"
       asp-action="Create"
       asp-route-productId="@Model.Id">
        Stok Giriş/Çıkış Yap
    </a>
}
<a class="btn btn-outline-secondary ms-2"
   asp-controller="StockMovements"
   asp-action="Index">
    Hareketleri Gör
</a>

@{
    ViewData["Title"] = "Ürün Detay";
}

<h1>Ürün Detay</h1>

<div class="card mt-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Ad</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Kategori</dt>
            <dd class="col-sm-9">@Model.Category</dd>

            <dt class="col-sm-3">Fiyat</dt>
            <dd class="col-sm-9">@Model.Price</dd>

            <dt class="col-sm-3">Stok</dt>
            <dd class="col-sm-9">@Model.Quantity</dd>

            <dt class="col-sm-3">Açıklama</dt>
            <dd class="col-sm-9">@Model.Description</dd>

            <dt class="col-sm-3">Eklenme</dt>
            <dd class="col-sm-9">@Model.CreatedDate</dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Düzenle</a>
    <a class="btn btn-secondary" asp-action="Index">Geri</a>
</div>
