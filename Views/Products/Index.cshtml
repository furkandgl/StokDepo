@model IEnumerable<StokDepo.Models.Product>
    @using System.Security.Claims

@{
    ViewData["Title"] = "Ürünler";

    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    string search = ViewBag.Query as string ?? "";
    string selectedCategory = ViewBag.SelectedCategory as string ?? "";
    string selectedStock = ViewBag.SelectedStock as string ?? "";
    string dateFrom = ViewBag.DateFrom as string ?? "";
    string dateTo = ViewBag.DateTo as string ?? "";
}

<h1 class="mb-3">Ürünler</h1>


<div class="card sd-card mb-3">
<div class="card-header pb-0">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-funnel"></i>
            <strong>Filtreler</strong>
            <span class="text-muted small">Ürünleri arayın ve filtreleyin</span>
        </div>
    </div>

    <div class="card-body">
        <form method="get" class="row g-3 align-items-end">

            <!-- SATIR 1 -->
            <div class="col-12 col-lg-4">
                <label class="form-label">Arama</label>
                <input type="text" name="q" value="@search" class="form-control" placeholder="Ürün adı..." />
            </div>

            <div class="col-12 col-lg-3">
                <label class="form-label">Kategori</label>
                <select name="category" class="form-select">
                    <option value="">Tümü</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c" selected="@(c == selectedCategory)">
                            @c
                        </option>
                    }
                </select>
            </div>

            <div class="col-6 col-lg-2">
                <label class="form-label">Başlangıç</label>
                <input type="date" name="dateFrom" value="@dateFrom" class="form-control" />
            </div>

            <div class="col-6 col-lg-2">
                <label class="form-label">Bitiş</label>
                <input type="date" name="dateTo" value="@dateTo" class="form-control" />
            </div>

            <!-- SATIR 2 -->
            <div class="col-12 col-lg-3">
                <label class="form-label">Stok Durumu</label>
                <select name="stock" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(selectedStock))">Tümü</option>
                    <option value="normal" selected="@(selectedStock == "normal")">Normal (6+)</option>
                    <option value="critical" selected="@(selectedStock == "critical")">Kritik (1-5)</option>
                    <option value="out" selected="@(selectedStock == "out")">Stok Yok (0)</option>
                </select>
            </div>

            <div class="col-12 col-lg-9">
                <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search me-1"></i> Filtrele
                    </button>

                    <a class="btn btn-outline-secondary" asp-action="Index">
                        <i class="bi bi-x-circle me-1"></i> Temizle
                    </a>

                    <a class="btn btn-outline-success"
                    data-no-loader
                       asp-action="ExportCsv"
                       asp-route-q="@search"
                       asp-route-category="@selectedCategory"
                       asp-route-stock="@selectedStock"
                       asp-route-dateFrom="@dateFrom"
                       asp-route-dateTo="@dateTo">
                        <i class="bi bi-download me-1"></i> CSV İndir
                    </a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a class="btn btn-success" asp-action="Create">
                            <i class="bi bi-plus-circle me-1"></i> Yeni Ürün Ekle
                        </a>
                    }
                </div>
            </div>

        </form>
    </div>
</div>


@if (Model == null || !Model.Any())
{
    <div class="sd-empty mt-4">
        <div class="sd-empty__icon">
            <i class="bi bi-box2 fs-3"></i>
        </div>
        <div class="sd-empty__title">Henüz ürün yok</div>
        <div class="sd-empty__text">İlk ürününü eklediğinde stok yönetimi burada başlayacak.</div>

        @if (User.IsInRole("Admin"))
        {
            <a class="btn btn-primary" asp-action="Create">Yeni Ürün Ekle</a>
        }
        else
        {
            <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Index">Dashboard’a Dön</a>
        }
    </div>
}
else
{
    var totalCount = Model.Count();
    var outCount = Model.Count(x => x.Quantity == 0);
    var criticalCount = Model.Count(x => x.Quantity > 0 && x.Quantity <= 5);
    var normalCount = totalCount - outCount - criticalCount;

<div class="card sd-card">
            <div class="card-header">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-box-seam"></i>
                    <strong>Ürün Listesi</strong>
                    <span class="text-muted small">(@totalCount kayıt)</span>
                </div>

                <div class="d-flex flex-wrap gap-2">
<span class="badge badge-soft-success badge-pill">Normal: @normalCount</span>
<span class="badge badge-soft-warning badge-pill">Kritik: @criticalCount</span>
<span class="badge badge-soft-danger badge-pill">Stok Yok: @outCount</span>

                </div>
            </div>
        </div>

        <div class="card-body pt-0">
<div class="sd-table">
  <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="small text-muted">
                        <tr>
                            <th>Ad</th>
                            <th>Kategori</th>
                            <th>Fiyat</th>
                            <th>Stok</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            string status;
                            string badgeClass;
                            string rowClass = "";

                        if (item.Quantity == 0)
{
    status = "Stok Yok";
    badgeClass = "badge-soft-danger badge-pill";
    rowClass = "soft-danger";
}
else if (item.Quantity <= 5)
{
    status = "Kritik Stok";
    badgeClass = "badge-soft-warning badge-pill";
    rowClass = "soft-warning";
}
else
{
    status = "Normal";
    badgeClass = "badge-soft-success badge-pill";
    rowClass = "";
}
   
                            <tr class="@rowClass">
                                <td class="fw-semibold">@item.Name</td>
                                <td>@item.Category</td>
                                <td>@item.Price.ToString("0.00") ₺</td>
                                <td>@item.Quantity</td>
                                <td><span class="badge @badgeClass">@status</span></td>

                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-secondary"
                                       asp-action="Details" asp-route-id="@item.Id" title="Detay">
                                        <i class="bi bi-info-circle"></i>
                                    </a>

                                    @if (User.IsInRole("Admin"))
                                    {
                                        <div class="btn-group ms-1" role="group">
                                            <a class="btn btn-sm btn-outline-primary"
                                               asp-action="Edit" asp-route-id="@item.Id" title="Düzenle">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a class="btn btn-sm btn-outline-danger"
                                               asp-action="Delete" asp-route-id="@item.Id" title="Sil">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @{
    int page = (int)(ViewBag.Page ?? 1);
    int pageSize = (int)(ViewBag.PageSize ?? 10);
    int totalPages = (int)(ViewBag.TotalPages ?? 1);

    string qParam = ViewBag.Query as string ?? "";
    string catParam = ViewBag.SelectedCategory as string ?? "";
    string stockParam = ViewBag.SelectedStock as string ?? "";
}

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(page-1)"
                   asp-route-pageSize="@pageSize"
                   asp-route-q="@qParam"
                   asp-route-category="@catParam"
                   asp-route-stock="@stockParam">
                    ‹
                </a>
            </li>

            @for (int p = 1; p <= totalPages; p++)
            {
                <li class="page-item @(p == page ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@p"
                       asp-route-pageSize="@pageSize"
                       asp-route-q="@qParam"
                       asp-route-category="@catParam"
                       asp-route-stock="@stockParam">
                        @p
                    </a>
                </li>
            }

            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@(page+1)"
                   asp-route-pageSize="@pageSize"
                   asp-route-q="@qParam"
                   asp-route-category="@catParam"
                   asp-route-stock="@stockParam">
                    ›
                </a>
            </li>
        </ul>
    </nav>
}


            </div>
        </div>
    </div>
    </div>
}


