<!DOCTYPE html>
<html lang="en">
<head>
   
   <script>
  (function () {
    const saved = localStorage.getItem('theme'); // 'dark' | 'light'
    if (saved === 'dark') document.documentElement.classList.add('theme-dark');
  })();
</script>

   
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StokDepo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StokDepo.styles.css" asp-append-version="true" />


</head>
<body>
    <header>
        
@{
    var currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLowerInvariant();

    string Active(string controllerName)
        => currentController == controllerName.ToLowerInvariant() ? "active fw-semibold" : "";
}

    

        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom box-shadow mb-3 sd-nav">


            <div class="container-fluid">
<a class="navbar-brand fw-bold"
   asp-area="" asp-controller="Home" asp-action="Index">
    StokDepo
</a>


                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
<span class="ms-2 d-sm-none">Menü</span>

                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
<ul class="navbar-nav flex-grow-1">

    <li class="nav-item">
        <a class="nav-link @Active("Home")"
           asp-controller="Home" asp-action="Index">
            <i class="bi bi-speedometer2 me-1"></i> Dashboard
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @Active("Products")"
           asp-controller="Products" asp-action="Index">
            <i class="bi bi-box-seam me-1"></i> Ürünler
        </a>
    </li>

    <li class="nav-item">
        <a class="nav-link @Active("StockMovements")"
           asp-controller="StockMovements" asp-action="Index">
            <i class="bi bi-arrow-left-right me-1"></i> Hareketler
        </a>
    </li>

    @if (User.IsInRole("Admin"))
    {
        <li class="nav-item">
            <a class="nav-link"
               asp-controller="Products" asp-action="Create">
                <i class="bi bi-plus-circle me-1"></i> Yeni Ürün
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link" asp-controller="Admin" asp-action="Users">
                <i class="bi bi-people me-1"></i> Kullanıcılar
            </a>
        </li>
    }

</ul>


    <div class="d-flex align-items-center gap-2">

    <!-- Dark/Light Toggle -->
<button id="themeToggle"
        type="button"
        class="btn btn-outline-secondary btn-sm sd-iconbtn"
        data-bs-toggle="tooltip"
        data-bs-placement="bottom"
        title="Tema değiştir"
        aria-label="Tema değiştir">
    <i class="bi bi-moon-stars"></i>
</button>


    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <span class="navbar-text small text-muted d-none d-md-inline">
            Merhaba, <strong>@User.Identity!.Name</strong>
        </span>

        <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
<button type="submit" class="btn btn-outline-danger btn-sm">
    <i class="bi bi-box-arrow-right me-1"></i>
    <span class="d-none d-md-inline">Çıkış</span>
</button>

        </form>
    }
    else
    {
<a class="btn btn-outline-primary btn-sm" asp-area="Identity" asp-page="/Account/Login">
    <i class="bi bi-box-arrow-in-right me-1"></i>
    <span class="d-none d-md-inline">Giriş</span>
</a>

    }
</div>
 </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

            @RenderBody()
            
        </main>
    </div>

    <div id="pageLoading" class="page-loading" aria-hidden="true">
    <div class="page-loading__card">
        <div class="spinner-border" role="status" aria-hidden="true"></div>
        <div class="mt-3 fw-semibold">Yükleniyor...</div>
        <div class="text-muted small">Lütfen bekleyin</div>
    </div>
</div>


    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - StokDepo - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

<script>
(function () {
  const overlay = document.getElementById('pageLoading');
  if (!overlay) return;

  const show = () => {
    overlay.classList.add('is-visible');
    overlay.setAttribute('aria-hidden', 'false');
  };

  const hide = () => {
    overlay.classList.remove('is-visible');
    overlay.setAttribute('aria-hidden', 'true');
  };

  // ✅ her sayfa gelişinde garanti kapat
  hide();
  window.addEventListener('pageshow', hide);
  window.addEventListener('load', hide);
  document.addEventListener('DOMContentLoaded', hide);

  // ✅ herhangi bir alan invalid olursa overlay kapat
  document.addEventListener('invalid', hide, true);

  // ✅ SUBMIT: sadece gerçekten submit olacaksa aç
  document.addEventListener('submit', function (e) {
    const form = e.target;
    if (!form || form.tagName !== 'FORM') return;

    // opt-out
    if (form.hasAttribute('data-no-loader')) return;

    // HTML5 validation
    if (typeof form.checkValidity === 'function' && !form.checkValidity()) {
      hide();
      return;
    }

    // jQuery unobtrusive validation varsa
    if (window.jQuery) {
      const $form = window.jQuery(form);
      if ($form.data('validator') && !$form.valid()) {
        hide();
        return;
      }
    }

    // submit iptal edilirse overlay kalmasın diye micro-delay
    setTimeout(() => {
      if (typeof form.checkValidity === 'function' && !form.checkValidity()) {
        hide();
        return;
      }
      show();
    }, 0);
  }, true);

  // ✅ LINK: gerçek navigasyonlarda aç
  document.addEventListener('click', function (e) {
    const a = e.target.closest('a');
    if (!a) return;

    // opt-out (CSV gibi)
    if (a.hasAttribute('data-no-loader')) return;

    if (a.target === '_blank') return;
    if (a.hasAttribute('download')) return;

    const href = a.getAttribute('href') || '';
    if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;

    show();
  }, true);

})();
</script>


<script>
  // Bootstrap tooltips init
  (function () {
    if (!window.bootstrap) return;
    document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
      new bootstrap.Tooltip(el);
    });
  })();
</script>


    <script>
  (function () {
    const btn = document.getElementById('themeToggle');
    if (!btn) return;

    const setIcon = () => {
      const dark = document.documentElement.classList.contains('theme-dark');
      btn.innerHTML = dark ? '<i class="bi bi-sun"></i>' : '<i class="bi bi-moon-stars"></i>';
      btn.classList.toggle('btn-outline-light', dark);
      btn.classList.toggle('btn-outline-secondary', !dark);
    };

    setIcon();

btn.addEventListener('click', () => {
  btn.classList.add('is-anim');
  setTimeout(() => btn.classList.remove('is-anim'), 220);

  document.documentElement.classList.toggle('theme-dark');
  const dark = document.documentElement.classList.contains('theme-dark');
  localStorage.setItem('theme', dark ? 'dark' : 'light');
  setIcon();
});

  })();
</script>


</body>
</html>
