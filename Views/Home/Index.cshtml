@{
    ViewData["Title"] = "Dashboard";
    var total = (int)(ViewBag.TotalProducts ?? 0);
    var critical = (int)(ViewBag.CriticalStock ?? 0);
    var outOfStock = (int)(ViewBag.OutOfStock ?? 0);
        var normal = total - critical - outOfStock;
    if (normal < 0) normal = 0;

    int Pct(int part, int whole) => whole <= 0 ? 0 : (int)Math.Round(part * 100.0 / whole);

    var pctNormal = Pct(normal, total);
    var pctCritical = Pct(critical, total);
    var pctOut = Pct(outOfStock, total);
    var recentMovements = ViewBag.RecentMovements as List<StokDepo.Models.StockMovement>
                          ?? new List<StokDepo.Models.StockMovement>();

    // =========================
    // Chart veri var mı?
    // =========================
    var barValsJson = (ViewBag.ChartValuesJson as string) ?? "[]";
    var doughValsJson = (ViewBag.StatusValuesJson as string) ?? "[]";

    bool HasJsonData(string json)
    {
        if (string.IsNullOrWhiteSpace(json)) return false;
        var t = json.Trim();
        if (t == "[]") return false;
        if (t == "[0]" || t == "[0,0]" || t == "[0,0,0]") return false;
        return true;
    }

    var hasBar = HasJsonData(barValsJson);
    var hasDough = HasJsonData(doughValsJson);
}

<div id="dashSkeleton">
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="sk sk-card"></div>
        </div>
        <div class="col-md-4">
            <div class="sk sk-card"></div>
        </div>
        <div class="col-md-4">
            <div class="sk sk-card"></div>
        </div>
    </div>

    <!-- Grafikler için skeleton -->
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="sk sk-chart"></div>
        </div>
        <div class="col-lg-4">
            <div class="sk sk-chart"></div>
        </div>
    </div>

    <!-- Son stok hareketleri tablo alanı skeleton -->
    <div class="mt-3">
        <div class="sk sk-table"></div>
    </div>
</div>

<div id="dashReal" class="d-none dash-enter">
        <div class="text-center">
    <h1 class="display-4">StokDepo</h1>
    <p class="text-muted">Dashboard</p>
</div>

<!-- Üst Kartlar -->
<div id="kpiRow" class="row g-3 mt-3">
    <!-- Toplam Ürün -->
    <div class="col-md-4">
        <div class="card sd-card sd-card--hover">
            <div class="card-body d-flex align-items-center">
                <div class="sd-icon sd-icon--primary me-3">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <div class="sd-sub">Toplam Ürün</div>
                    <div class="fs-3 sd-title">@total</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Kritik Stok -->
    <div class="col-md-4">
        <div class="card sd-card sd-card--hover">
            <div class="card-body d-flex align-items-center">
                <div class="sd-icon sd-icon--warning me-3">
                    <i class="bi bi-exclamation-triangle"></i>
                </div>
                <div>
                    <div class="sd-sub">Kritik Stok (1–5)</div>
                    <div class="fs-3 sd-title">@critical</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Stok Yok -->
    <div class="col-md-4">
        <div class="card sd-card sd-card--hover">
            <div class="card-body d-flex align-items-center">
                <div class="sd-icon sd-icon--danger me-3">
                    <i class="bi bi-x-circle"></i>
                </div>
                <div>
                    <div class="sd-sub">Stok Yok</div>
                    <div class="fs-3 sd-title">@outOfStock</div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="card sd-card mt-4 dash-pop" data-pop>
    <div class="card-header">
        <div class="sd-title">Son 14 Gün: Günlük Net Stok Değişimi</div>
        <div class="sd-sub small">(+ giriş / - çıkış)</div>
    </div>

    <div class="card-body" style="height: 220px;">
        @if (!hasBar)
        {
            <div class="sd-empty h-100 d-flex flex-column justify-content-center">
                <div class="sd-empty__icon">
                    <i class="bi bi-bar-chart-line fs-3"></i>
                </div>
                <div class="sd-empty__title">Grafik için veri yok</div>
                <div class="sd-empty__text">
                    Son 14 gün içinde stok hareketi bulunamadı.
                </div>
            </div>
        }
        else
        {
            <canvas id="stockChart" class="w-100 h-100"></canvas>
        }
    </div>
</div>


<div class="card sd-card mt-4 dash-pop" data-pop>
    <div class="card-header">
        <div class="sd-title">Stok Durumu Dağılımı</div>
        <div class="sd-sub small">(Normal / Kritik / Stok Yok)</div>
    </div>

   <div class="card-body d-flex justify-content-center align-items-center" style="height: 340px;">
    @if (!hasDough)
    {
        <div class="sd-empty">
            <div class="sd-empty__icon">
                <i class="bi bi-pie-chart fs-3"></i>
            </div>
            <div class="sd-empty__title">Dağılım için veri yok</div>
            <div class="sd-empty__text">
                Ürün ekleyip stok girişi yaptığında dağılım burada görünecek.
            </div>

            @if (User.IsInRole("Admin"))
            {
                <a class="btn btn-primary mt-2"
                   asp-controller="Products"
                   asp-action="Create">
                    Yeni Ürün Ekle
                </a>
            }
            else
            {
                <a class="btn btn-outline-primary mt-2"
                   asp-controller="Products"
                   asp-action="Index">
                    Ürünleri Gör
                </a>
            }
        </div>
    }
    else
    {
        <div class="position-relative" style="width: 260px; height: 260px;">
            <canvas id="statusDoughnut"></canvas>

            <!-- Ortadaki yazı -->
            <div class="position-absolute top-50 start-50 translate-middle text-center">
                <div class="sd-title fs-3">@total</div>
                <div class="sd-sub small mb-2">Toplam</div>

                <!-- Yüzde breakdown -->
                <div class="d-grid gap-2 text-start" style="min-width: 160px;">
                    <div class="sd-pill">
                        <span class="sd-dot" style="background: var(--bs-success);"></span>
                        <span class="text-success">Normal</span>
                        <span class="ms-auto fw-semibold">@pctNormal%</span>
                    </div>

                    <div class="sd-pill">
                        <span class="sd-dot" style="background: var(--bs-warning);"></span>
                        <span class="text-warning">Kritik</span>
                        <span class="ms-auto fw-semibold">@pctCritical%</span>
                    </div>

                    <div class="sd-pill">
                        <span class="sd-dot" style="background: var(--bs-danger);"></span>
                        <span class="text-danger">Stok Yok</span>
                        <span class="ms-auto fw-semibold">@pctOut%</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>




<!-- Son Stok Hareketleri (2D Premium) -->
<div class="row mt-4 justify-content-center">
    <div class="col-lg-10 col-md-12">
        <div class="card sd-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-clock-history"></i>
                    <div>
                        <div class="sd-title">Son Stok Hareketleri</div>
                        <div class="sd-sub small">Son 5 hareket</div>
                    </div>
                </div>

                <a class="btn btn-outline-secondary btn-sm"
                   asp-controller="StockMovements"
                   asp-action="Index">
                    Tümünü Gör
                </a>
            </div>

            <div class="card-body">
                @if (recentMovements == null || !recentMovements.Any())
                {
                    <div class="sd-empty">
                        <div class="sd-empty__icon">
                            <i class="bi bi-inboxes fs-3"></i>
                        </div>
                        <div class="sd-empty__title">Henüz stok hareketi yok</div>
                        <div class="sd-empty__text">İlk giriş/çıkış hareketi oluştuğunda burada görünecek.</div>

                        @if (User.IsInRole("Admin"))
                        {
                            <a class="btn btn-primary" asp-controller="Products" asp-action="Create">Yeni Ürün Ekle</a>
                        }
                        else
                        {
                            <a class="btn btn-outline-primary" asp-controller="Products" asp-action="Index">Ürünleri Gör</a>
                        }
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush sd-list">
                        @foreach (var m in recentMovements)
                        {
                            var badgeClass = m.QuantityChange >= 0 ? "badge-soft-success" : "badge-soft-danger";
                            var text = m.QuantityChange >= 0 ? $"+{m.QuantityChange}" : m.QuantityChange.ToString();

                            <li class="list-group-item d-flex justify-content-between align-items-center sd-list__item">
                                <div class="me-3">
                                    <div class="fw-semibold">@m.Product?.Name</div>

                                    <div class="sd-sub small">
                                        @m.PerformedBy • @m.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(m.Note))
                                    {
                                        <div class="sd-sub small mt-1">@m.Note</div>
                                    }
                                </div>

                                <span class="badge @badgeClass badge-pill">@text</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <div class="mt-4 text-center">
            <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Ürünlere Git</a>
        </div>
    </div>
</div> 
</div>




@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
  function initCharts() {
    const hasBar = @hasBar.ToString().ToLower();
    const hasDough = @hasDough.ToString().ToLower();

    // BAR (stockChart) -> sadece veri varsa
    if (hasBar) {
      const labels = @Html.Raw(ViewBag.ChartLabelsJson ?? "[]");
      const values = @Html.Raw(ViewBag.ChartValuesJson ?? "[]");

      const stockCanvas = document.getElementById('stockChart');
      if (stockCanvas) {
        new Chart(stockCanvas, {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [{
              label: 'Net Değişim',
              data: values,
              borderWidth: 1
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: { y: { ticks: { precision: 0 } } }
          }
        });
      }
    }

    // DOUGHNUT (statusDoughnut) -> sadece veri varsa
    if (hasDough) {
      const statusLabels = @Html.Raw(ViewBag.StatusLabelsJson ?? "[]");
      const statusValues = @Html.Raw(ViewBag.StatusValuesJson ?? "[]");

      const doughnutCanvas = document.getElementById('statusDoughnut');
      if (doughnutCanvas) {
        new Chart(doughnutCanvas, {
          type: 'doughnut',
          data: {
            labels: statusLabels,
            datasets: [{
              data: statusValues,
              borderWidth: 0
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '75%',
            plugins: { legend: { display: false } }
          }
        });
      }
    }
  }
</script>


     <script>
        // Skeleton -> Real geçiş + motion tetikleme (kurşun geçirmez)
        document.addEventListener("DOMContentLoaded", function () {
            const sk = document.getElementById('dashSkeleton');
            const real = document.getElementById('dashReal');
            if (!sk || !real) return;

            const prefersReduced =
                window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

setTimeout(() => {
    // 1) skeleton kapat, real aç
    sk.classList.add('d-none');
    real.classList.remove('d-none');
    if (!sk || !real) return;
    if (typeof initCharts === 'function') initCharts();

    const kpiRow = document.getElementById("kpiRow");
    real.classList.remove('is-ready');
    if (kpiRow) kpiRow.classList.remove('is-ready');
    document.querySelectorAll('[data-pop]').forEach(p => p.classList.remove('is-ready'));
    void real.offsetHeight;
    if (kpiRow) void kpiRow.offsetHeight;

    requestAnimationFrame(() => {
        requestAnimationFrame(() => {
            real.classList.add('is-ready');
            if (kpiRow) kpiRow.classList.add('is-ready');

            document.querySelectorAll('[data-pop]').forEach(p => p.classList.add('is-ready'));
            window.dispatchEvent(new Event('resize'));
        });
    });

}, 250);


        });
    </script>
}

