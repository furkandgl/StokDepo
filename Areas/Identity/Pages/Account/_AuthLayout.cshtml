@{
    Layout = null;
    var title = (ViewData["Title"] as string) ?? "StokDepo";
}

<!doctype html>
<html lang="tr">
<head>
    <script>
        (function () {
            const saved = localStorage.getItem('theme');
            if (saved === 'dark') document.documentElement.classList.add('theme-dark');
        })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title - StokDepo</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>

<body class="auth-body">
    <div class="container min-vh-100 d-flex align-items-center justify-content-center py-4">
        <div style="width: min(520px, 100%);">

          <div class="text-center mb-4">
    <div class="d-inline-flex align-items-center gap-2 px-3 py-2 rounded-4"
         style="border:1px solid var(--card-border); background: color-mix(in srgb, var(--card-bg) 92%, transparent);">
        <i class="bi bi-box-seam fs-4"></i>
        <span class="fw-bold fs-5">StokDepo</span>
    </div>
    <div class="text-muted small mt-2">Stok yönetim paneli</div>
</div>


            @RenderBody()
        </div>
    </div>

    <!-- Global Loading Overlay -->
    <div id="pageLoading" class="page-loading" aria-hidden="true">
        <div class="page-loading__card">
            <div class="spinner-border" role="status" aria-hidden="true"></div>
            <div class="mt-3 fw-semibold">Yükleniyor...</div>
            <div class="text-muted small">Lütfen bekleyin</div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)

<script>
(function () {
  const overlay = document.getElementById('pageLoading');
  if (!overlay) return;

  const show = () => {
    overlay.classList.add('is-visible');
    overlay.setAttribute('aria-hidden', 'false');
  };

  const hide = () => {
    overlay.classList.remove('is-visible');
    overlay.setAttribute('aria-hidden', 'true');
  };

  // ✅ her sayfa gelişinde garanti kapat
  hide();
  window.addEventListener('pageshow', hide);
  window.addEventListener('load', hide);
  document.addEventListener('DOMContentLoaded', hide);

  // ✅ invalid olursa kapat
  document.addEventListener('invalid', hide, true);

  document.addEventListener('submit', function (e) {
    const form = e.target;
    if (!form || form.tagName !== 'FORM') return;

    // HTML5 validation
    if (typeof form.checkValidity === 'function' && !form.checkValidity()) {
      hide();
      return;
    }

    // jQuery unobtrusive varsa
    if (window.jQuery) {
      const $form = window.jQuery(form);
      if ($form.data('validator') && !$form.valid()) {
        hide();
        return;
      }
    }

    setTimeout(() => {
      if (typeof form.checkValidity === 'function' && !form.checkValidity()) {
        hide();
        return;
      }
      show();
    }, 0);
  }, true);

  document.addEventListener('click', function (e) {
    const a = e.target.closest('a');
    if (!a) return;

    if (a.target === '_blank') return;
    if (a.hasAttribute('download')) return;

    const href = a.getAttribute('href') || '';
    if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;

    show();
  }, true);

})();
</script>

</body>
</html>



